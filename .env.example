# Copiar a .env y completar con valores reales (nunca commitear .env)
# Los valores de ejemplo coinciden con los defaults de /docker-compose.yml
# para que el backend se conecte sin tocar nada en desarrollo local.

# Si ya tenés un Postgres corriendo en el puerto 5432 (instalado nativo,
# otro contenedor, etc.), cambiá POSTGRES_PORT acá y en DATABASE_URL.
DATABASE_URL=postgresql://meeple:meeple@localhost:5432/meeple

# Base separada para los tests (creála una vez con: createdb -U meeple meeple_test,
# o "docker exec <container> createdb -U meeple meeple_test"). Los tests crean y
# destruyen las tablas ahí, nunca tocan la base de desarrollo.
TEST_DATABASE_URL=postgresql://meeple:meeple@localhost:5432/meeple_test

# Usado para firmar los JWT de auth. Generar uno propio en cada entorno,
# por ejemplo con: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=changeme
